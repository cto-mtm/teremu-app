{
  // tsx only: resolve @teremu/shared to its SOURCE, so the reset never
  // depends on a stale shared/dist (no build step before a demo).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "paths": { "@teremu/shared": ["shared/src/index.ts"] },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts"]
}
