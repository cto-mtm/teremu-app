# Copy to .env.production before building for deploy. Values come from
# the Firebase console (Project settings → Your apps → Web app), or:
#
#   firebase apps:sdkconfig web <APP_ID> --project <PROJECT_ID>
#
# Only .env.production — NOT .env. Vite loads .env in dev too, and that
# would point `npm run dev` at the real project instead of the Auth
# emulator, breaking the offline local-first flow.
#
# All four are public by design: the Firebase web API key identifies the
# project, it does not authorize anything, and it ships in the JS bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_APP_ID=

# Optional: override the API base URL (defaults to the us-east1
# Cloud Function in prod, the emulator in dev). See src/lib/api.ts.
# VITE_API_URL=
