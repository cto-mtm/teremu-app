{
  "hosting": {
    "public": "app",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/oauth/email/callback", "function": { "functionId": "emailOauthCallback", "region": "us-east1" } },
      { "source": "!/assets/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://us-east1-teremu-app.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://teremu-app.firebaseapp.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      { "source": "!/@(assets|images)/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default" }
  ],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 10403 },
    "functions": { "port": 10404 },
    "firestore": { "port": 10405, "websocketPort": 10406 },
    "storage": { "port": 10410 },
    "hosting": { "port": 10408 },
    "ui": { "enabled": true, "port": 10400 },
    "hub": { "port": 10401 },
    "logging": { "port": 10402 },
    "eventarc": { "port": 10411 },
    "tasks": { "port": 10412 },
    "singleProjectMode": true
  }
}
