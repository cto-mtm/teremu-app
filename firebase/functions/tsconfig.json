{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@mtmcya/assistant": [
        "../../../mtmcya-app-assistant/src/contracts/index.ts"
      ],
      "@mtmcya/assistant/*": [
        "../../../mtmcya-app-assistant/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
