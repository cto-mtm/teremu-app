STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
APP_URL=http://localhost:5173

# OCR/AI model override (see src/llm.ts + docs/llm.md). Prod uses Nemotron —
# it read 208/248 real invoice totals correctly vs 21/248 for the NVIDIA
# preset (docs/real-samples.md). Unset = the provider preset.
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# POS integrations (docs/pos.md, src/pos/). Leave unset locally: the emulator
# then runs the deterministic mock provider (even with SQUARE_APP_SECRET in
# .secret.local — local live-Square tests also need SQUARE_APP_ID set here).
# Deployed: the production app id is the code default, so only the secret is
# required; without it → 501.
# SQUARE_APP_ID=sq0idp-...      # default: Teremu's production app; use a sandbox-… id to test
# SQUARE_ENV=production         # default: inferred from the app id
# SQUARE_API_VERSION=           # pin after checking Square's changelog
# POS_OAUTH_REDIRECT_URL=       # default: this project's posOauthCallback URL
# Secrets: `node scripts/pos-secrets.mjs` sets SQUARE_APP_SECRET and creates
# POS_TOKEN_ENC_KEY=v1:<base64 of 32 random bytes> (--rotate prepends v2:…).

# Transactional email via mtmcya-mailer (docs/mtmcya-mailer.md). Set ONLY in
# .env.teremu-app (prod) — leave it unset locally so sendMail logs and skips:
# MAILER_URL=https://us-central1-mtmcya-mailer.cloudfunctions.net/sendEndpoint

# Assistant (@mtmcya/assistant → Vertex AI Gemini 3.x via Application Default
# Credentials; docs/llm.md § Assistant). Gemini 3.x is served from the
# `global` location only. Locally: `gcloud auth application-default login`.
# Leave both unset to get a 500 on /assistant turns; the test suite never
# needs them (TEREMU_TEST_MOCKS swaps in a scripted model).
# GOOGLE_VERTEX_PROJECT=teremu-app
# GOOGLE_VERTEX_LOCATION=global

# "Find your restaurant" first-run step (docs/restaurant-listing.md). While
# the import is still mocked it is ON in the emulator and OFF when deployed;
# set LISTING_SETUP=on in .env.teremu-app once Phase 1 ships (or =off locally
# to get the old first-run flow back).
# LISTING_SETUP=on
