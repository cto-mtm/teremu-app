{
  "name": "teremu-functions",
  "description": "Cloud Functions API for Teremu — invoices, OCR, pantry, margins",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "seed": "npm run build && node lib/seed-cli.js",
    "migrate": "npm run build && node lib/migrate-cli.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "stripe": "^17.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@teremu/shared": "*",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
