{
  "name": "teremu-functions",
  "description": "Cloud Functions API for Teremu — invoices, OCR, pantry, margins",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "seed": "npm run build && node lib/seed-cli.js",
    "migrate": "npm run build && node lib/migrate-cli.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "vitest run --config vitest.real.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.111",
    "ai": "^7.0.139",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1",
    "stripe": "^17.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
