# Logs
logs
*.log
npm-debug.log*
firebase-debug*.log*

# Firebase
.firebase/
firebase/.firebase/
# Built SPA copied in by scripts/deploy.sh — always regenerated, never committed
firebase/app/

# Dependencies / build output
node_modules/
dist/
# Functions bundle (esbuild output — regenerated by `npm run build`)
firebase/functions/lib/

# Environment (keep .env.example)
.env
.env.*
!.env.example

# Firebase Functions v2 local secrets. Real keys are fine here: the test
# suite stays hermetic by forcing offline mocks via TEREMU_TEST_MOCKS
# (set in firebase/package.json's test script).
.secret.local

# Native shells — generated by `npx cap add ios|android`. Excluded by default;
# remove these two lines once you start customizing native code and want them in git.
app/ios/
app/android/

# Misc
.DS_Store
.claude/
